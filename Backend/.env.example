PORT=8000
MONGO_URI=mongodb://localhost:27017/balancebuddy
JWT_SECRET=your_jwt_secret_key
FRONTEND_URL=http://localhost:3000

# EmailJS Configuration
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Optional separate template IDs (defaults to EMAILJS_TEMPLATE_ID if not set)
# EMAILJS_OTP_TEMPLATE_ID=your_otp_template_id
# EMAILJS_RESET_TEMPLATE_ID=your_password_reset_template_id

# AI Insights (Perplexity API)
PERPLEXITY_API_KEY=your_perplexity_api_key

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
